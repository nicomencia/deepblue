# --- Core (apps/web) ---
DATABASE_URL=postgres://user:password@localhost:5432/deepblue
ANTHROPIC_API_KEY=sk-ant-...

# Email (Resend). Without RESEND_API_KEY, emails print to the server log.
RESEND_API_KEY=re_...
EMAIL_FROM="deepblue <onboarding@resend.dev>"
# Instant alerts fire for grades at or above this (A|B|C...); digest covers the rest
ALERT_MAX_GRADE=B

# Scheduling. Local mode: set ENABLE_LOCAL_SCHEDULER=1 and the web server
# sweeps every SWEEP_INTERVAL_MINUTES (08-23h Madrid) and sends the digest
# each morning. Cloud mode: leave unset; point Cloud Scheduler at
# POST /api/cron/sweep and /api/cron/digest with "Authorization: Bearer $CRON_SECRET".
ENABLE_LOCAL_SCHEDULER=1
SWEEP_INTERVAL_MINUTES=180
CRON_SECRET=change-me

# --- Runner (apps/runner) ---
# The runner loads env itself: apps/runner/.env.local, then .env.local (repo
# root), then apps/web/.env.local — first file to define a var wins; real
# environment variables always win over files.
# CORE_API_URL defaults to http://localhost:3000 (set it on split deployments).
CORE_API_URL=http://localhost:3000
RUNNER_TOKEN=dev-runner-token
# Where the persistent (logged-in) browser profile lives on the runner machine
BROWSER_PROFILE_DIR=.browser-profile
